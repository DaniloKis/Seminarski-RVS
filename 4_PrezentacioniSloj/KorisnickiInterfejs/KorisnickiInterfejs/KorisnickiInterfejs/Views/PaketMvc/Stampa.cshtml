@model System.Collections.Generic.List<KlasePodataka.PaketKlasa>
@{
    Layout = null;  // stampa - bez glavnog menija
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Stampa spiska paketa</title>
    <style type="text/css">
        body { font-family: Arial, sans-serif; color: #000; }
        h2 { text-align: center; }
        table { border-collapse: collapse; width: 100%; }
        th, td { border: 1px solid #000; padding: 4px 8px; text-align: left; }
        .zaglavlje { text-align: center; margin-bottom: 16px; }
        @@media print { .noprint { display: none; } }
    </style>
</head>
<body>
    <div class="zaglavlje">
        <strong>KURIRSKA SLUZBA</strong><br />
        EVIDENCIJA PAKETA
    </div>
    <h2>@ViewBag.Naslov</h2>

    <table>
        <thead>
            <tr>
                <th>Kod paketa</th>
                <th>Posiljalac</th>
                <th>Primalac</th>
                <th>Grad primaoca</th>
                <th>Tezina (kg)</th>
                <th>Cena</th>
                <th>Tip vozila</th>
            </tr>
        </thead>
        <tbody>
            @if (Model == null || Model.Count == 0)
            {
                <tr><td colspan="7">Nema paketa.</td></tr>
            }
            else
            {
                foreach (var p in Model)
                {
                    <tr>
                        <td>@p.KodPaketa</td>
                        <td>@p.PosiljalacIme</td>
                        <td>@p.PrimalacIme</td>
                        <td>@p.PrimalacGrad</td>
                        <td>@p.Tezina</td>
                        <td>@p.Cena</td>
                        <td>@(p.TipVozila != null ? p.TipVozila.Naziv : "")</td>
                    </tr>
                }
            }
        </tbody>
    </table>

    <p class="noprint" style="margin-top:16px;">
        <button onclick="window.print()">Stampaj</button>
    </p>
</body>
</html>
